rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi phụ huynh chỉ đọc/ghi được dữ liệu của chính mình: users/{uid}/...
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /kids/{kidId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 20;

        match /mistakes/{k} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Bảng xếp hạng: ai cũng xem được (chỉ có tên gọi, con vật đại diện và các con số).
    // Mã bản ghi là {uid}_{kidId}: phụ huynh chỉ ghi/xóa được bản ghi của con mình.
    match /leaderboard/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.kidId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.allStars is int && request.resource.data.allStars >= 0 && request.resource.data.allStars <= 100000
        && request.resource.data.allDone is int && request.resource.data.allDone >= 0
        && request.resource.data.bestStreak is int && request.resource.data.bestStreak >= 0
        && request.resource.data.bestExam is int && request.resource.data.bestExam >= 0 && request.resource.data.bestExam <= 100
        && (!('grade' in request.resource.data) || (request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 5));
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_.+');
    }
  }
}
